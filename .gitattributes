# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force scripts and documentation to LF
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.db binary
