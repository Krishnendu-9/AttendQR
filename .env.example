# Copy to .env and adjust. Every value is optional.

# Leave SECRET_KEY unset: AttendQR generates a private key in instance/secret_key on
# first start. Only set it when several servers must share one key, and then use a
# long random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

DATABASE_URL=sqlite:///attendance.db

# Initial Principal account, created only when the database has no accounts yet.
# Leave DEFAULT_PRINCIPAL_PASSWORD unset: a random one-time password is written to
# instance/initial_principal_password (the server log shows the path, not the password)
# and the file is deleted once the Principal replaces it at first login.
DEFAULT_PRINCIPAL_EMAIL=principal@example.com
# DEFAULT_PRINCIPAL_PASSWORD=

# Comma-separated email domains allowed for staff accounts (Principal, HOD, Teacher).
# There is no default: until this is set, no HOD or Teacher accounts can be created.
# Add a public domain such as @gmail.com only for testing; anyone can get one.
ALLOWED_STAFF_DOMAINS=@rcciit.org.in, @gmail.com

# QR scan links. Leave unset to detect this machine's LAN IP automatically.
#
# WARNING: on the LAN, only phones on the campus network can open a scan link, which
# stops a forwarded QR from working for a student at home. If APP_BASE_URL or
# APP_HOST_IP is reachable from the internet, set SCAN_ALLOWED_NETWORKS below to the
# campus network's public IP ranges. See "Before deploying on a public address" in README.md.
# APP_HOST_IP=192.168.0.170
# APP_BASE_URL=https://attendance.example.edu
# APP_PORT=5000

# Client IP ranges allowed to open a scan link (comma-separated CIDR), or "any".
# Empty = private LAN addresses only (not 127.0.0.1; for local testing in a browser on
# this machine use 127.0.0.0/8). A malformed value stops the app from starting.
# Before relying on it on a real server (especially under Docker or behind a proxy),
# check the app sees real client addresses: README.md, "Check the app sees real client addresses".
# SCAN_ALLOWED_NETWORKS=203.0.113.0/24

# Days to keep the IP address each QR scan came from (shown to staff in the session
# view). The app deletes older ones itself. 0 = record none and delete existing ones.
# See "Scan IP addresses" in README.md.
# SCAN_IP_RETENTION_DAYS=30

# QR timing, in seconds. A QR code is accepted for QR_TOKEN_MAX_AGE after it is shown;
# the screen shows a new one every QR_REFRESH_SECONDS, which must be smaller. After a
# valid scan the student has SCAN_GRANT_SECONDS (at least 30) to log in and confirm.
# The app refuses to start if these are not whole numbers or are inconsistent.
# QR_TOKEN_MAX_AGE=30
# QR_REFRESH_SECONDS=10
# SCAN_GRANT_SECONDS=300

# Minutes without activity before a signed-in user is signed out (0 = never). Logins
# also end when the browser is closed.
# SESSION_IDLE_MINUTES=60

# Failed logins from one client address, across all accounts, before that address is
# paused for 10 minutes (per 10 minutes; 0 = off). Raise it, or set 0, on a public
# deployment where the whole campus reaches the server from one shared address.
# LOGIN_IP_TOTAL_FAILURE_LIMIT=100

# Set to 1 once the site is served over HTTPS (marks cookies Secure).
# SESSION_COOKIE_SECURE=1
# Number of reverse proxies (nginx, etc.) in front of the app, so client IPs are correct.
# TRUSTED_PROXY_COUNT=1

# Migrations run automatically at startup. With several worker processes, set this
# to 0 and run `flask init-db` once per deployment instead.
# AUTO_MIGRATE=1

# Server (run.py)
# FLASK_RUN_PORT=5000
# FLASK_DEBUG=0

# The college's time zone (IANA name). Times are stored in UTC and shown in this zone.
# TIMEZONE=Asia/Kolkata

# Logging: "json" for one JSON object per line. The access log (on by default) records
# route patterns and status codes only, never client addresses or QR tokens.
# LOG_FORMAT=text
# ACCESS_LOG=1

# Prometheus metrics at /metrics, only with this token: Authorization: Bearer <token>
# METRICS_TOKEN=

# Roles that must use two-step sign-in (an authenticator app code). "none" requires nobody.
# TOTP_REQUIRED_ROLES=principal,hod
# TOTP_ISSUER=AttendQR

# Exam eligibility: eligible at or above, condonable from, detained below.
# ELIGIBILITY_PERCENT=75
# CONDONATION_PERCENT=65
