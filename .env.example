SECRET_KEY=change-this-secret-key
DATABASE_URL=sqlite:///attendance.db

# Initial Principal account used only when the database has no accounts yet.
DEFAULT_PRINCIPAL_EMAIL=principal@example.com
DEFAULT_PRINCIPAL_PASSWORD=ChangeMe123!

# Comma-separated list of allowed email domains for staff accounts (Principal, HOD, Teacher)
ALLOWED_STAFF_DOMAINS=@rcciit.org.in,@gmail.com

# Optional: use these if automatic LAN IP detection is not suitable.
# APP_HOST_IP=192.168.0.170
# APP_BASE_URL=http://192.168.0.170:5000
# APP_PORT=5000
