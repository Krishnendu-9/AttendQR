# Copy to .env and adjust. Every value is optional.

# Leave SECRET_KEY unset: AttendQR generates a private key in instance/secret_key on
# first start. Only set it when several servers must share one key, and then use a
# long random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

DATABASE_URL=sqlite:///attendance.db

# Initial Principal account, created only when the database has no accounts yet.
# It must choose a new password at first login.
DEFAULT_PRINCIPAL_EMAIL=principal@example.com
DEFAULT_PRINCIPAL_PASSWORD=ChangeMe123!

# Comma-separated email domains allowed for staff accounts (Principal, HOD, Teacher).
# Remove @gmail.com for a real deployment.
ALLOWED_STAFF_DOMAINS=@rcciit.org.in,@gmail.com

# QR scan links. Leave unset to detect this machine's LAN IP automatically.
# APP_HOST_IP=192.168.0.170
# APP_BASE_URL=https://attendance.example.edu
# APP_PORT=5000

# Set to 1 once the site is served over HTTPS (marks cookies Secure).
# SESSION_COOKIE_SECURE=1
# Number of reverse proxies (nginx, etc.) in front of the app, so client IPs are correct.
# TRUSTED_PROXY_COUNT=1

# Migrations run automatically at startup. With several worker processes, set this
# to 0 and run `flask init-db` once per deployment instead.
# AUTO_MIGRATE=1

# Server (run.py)
# FLASK_RUN_PORT=5000
# FLASK_DEBUG=0
