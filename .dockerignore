# Only what the image needs; never local secrets or data.
.git
.github
.env
.env.*
venv
.venv
instance
*.db
*.db-wal
*.db-shm
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.coverage
htmlcov
test-results
# Local tools and notes (the Tailwind binary alone is over 100 MB), never part of the build
tools
dev_docs
.claude
.vscode
tests
docs
scripts
